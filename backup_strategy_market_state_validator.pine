//@version=6
strategy("Market State Validator - 180s Options Backup", 
         shorttitle="MSV Backup", 
         overlay=true, 
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=100,
         commission_type=strategy.commission.percent,
         commission_value=0.1,
         slippage=2)

// ═══════════════════════════════════════════════════════════════════════════════
// MARKET STATE VALIDATOR - BACKUP STRATEGY FOR 180s OPTIONS DECISIONS
// ═══════════════════════════════════════════════════════════════════════════════
// Purpose: Structural confirmation and market state classification
// NOT a direct entry signal generator - this is a validation/filter layer
// Designed for manual CALL/PUT decisions on myrockitcoin.com
// Strategy trades simulate validation confidence, not actual broker execution
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS - CORE CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════════

// HTF Configuration
htf_timeframe = input.timeframe("3", "HTF Timeframe", group="HTF Bias")
htf_fast_len = input.int(8, "HTF Fast EMA", minval=3, maxval=50, group="HTF Bias")
htf_slow_len = input.int(21, "HTF Slow EMA", minval=10, maxval=100, group="HTF Bias")
htf_strength_len = input.int(14, "HTF Strength Period", minval=5, maxval=50, group="HTF Bias")

// Regime Detection
adx_len = input.int(14, "ADX Length", minval=5, maxval=50, group="Regime Detection")
adx_trend_threshold = input.float(25.0, "ADX Trend Threshold", minval=15.0, maxval=50.0, step=1.0, group="Regime Detection")
adx_strong_threshold = input.float(35.0, "ADX Strong Threshold", minval=25.0, maxval=60.0, step=1.0, group="Regime Detection")
efficiency_len = input.int(20, "Efficiency Period", minval=10, maxval=50, group="Regime Detection")
efficiency_threshold = input.float(0.35, "Efficiency Threshold", minval=0.2, maxval=0.6, step=0.05, group="Regime Detection")

// Structure & Pullback
ema_fast = input.int(8, "Fast EMA", minval=3, maxval=30, group="Structure")
ema_mid = input.int(21, "Mid EMA", minval=10, maxval=50, group="Structure")
ema_slow = input.int(55, "Slow EMA", minval=30, maxval=100, group="Structure")
pullback_depth_threshold = input.float(0.4, "Pullback Depth (ATR)", minval=0.2, maxval=1.0, step=0.1, group="Structure")
extension_threshold = input.float(1.5, "Extension Threshold (ATR)", minval=1.0, maxval=3.0, step=0.1, group="Structure")

// Exhaustion Detection
exhaustion_roc_len = input.int(5, "Exhaustion ROC Period", minval=3, maxval=20, group="Exhaustion")
exhaustion_roc_threshold = input.float(2.0, "Exhaustion ROC % Threshold", minval=1.0, maxval=5.0, step=0.5, group="Exhaustion")
exhaustion_extension = input.float(2.0, "Exhaustion Extension (ATR)", minval=1.5, maxval=3.0, step=0.25, group="Exhaustion")

// Volatility Regimes
atr_len = input.int(14, "ATR Length", minval=5, maxval=30, group="Volatility")
vol_low_percentile = input.float(30.0, "Low Vol Percentile", minval=10.0, maxval=40.0, step=5.0, group="Volatility")
vol_high_percentile = input.float(70.0, "High Vol Percentile", minval=60.0, maxval=90.0, step=5.0, group="Volatility")
vol_lookback = input.int(100, "Vol Lookback Period", minval=50, maxval=200, group="Volatility")

// Session Quality
enable_session_filter = input.bool(true, "Enable Session Filter", group="Session")
session_timezone = input.string("America/New_York", "Timezone", group="Session")
asia_quality = input.float(0.6, "Asia Session Quality", minval=0.0, maxval=1.0, step=0.1, group="Session")
london_quality = input.float(0.9, "London Session Quality", minval=0.0, maxval=1.0, step=0.1, group="Session")
ny_quality = input.float(1.0, "NY Session Quality", minval=0.0, maxval=1.0, step=0.1, group="Session")
other_quality = input.float(0.5, "Other Session Quality", minval=0.0, maxval=1.0, step=0.1, group="Session")

// Strategy Execution
hold_bars_30s = input.int(6, "Hold Bars (30s chart)", minval=3, maxval=20, group="Strategy Execution")
hold_bars_15s = input.int(12, "Hold Bars (15s chart)", minval=6, maxval=30, group="Strategy Execution")
cooldown_bars = input.int(3, "Cooldown Between Trades", minval=0, maxval=10, group="Strategy Execution")
min_confidence = input.float(60.0, "Min Confidence for Entry", minval=40.0, maxval=80.0, step=5.0, group="Strategy Execution")

// Confirmation Thresholds
strong_bias_threshold = input.float(75.0, "Strong Bias Threshold", minval=60.0, maxval=90.0, step=5.0, group="Confirmation")
weak_bias_threshold = input.float(55.0, "Weak Bias Threshold", minval=40.0, maxval=70.0, step=5.0, group="Confirmation")

// Visual Settings
show_dashboard = input.bool(true, "Show Dashboard", group="Visuals")
show_state_labels = input.bool(true, "Show State Labels", group="Visuals")
show_bg_tint = input.bool(true, "Show Background Tint", group="Visuals")
show_htf_ribbon = input.bool(true, "Show HTF Ribbon", group="Visuals")

// ═══════════════════════════════════════════════════════════════════════════════
// CORE CALCULATIONS - ATR & VOLATILITY
// ═══════════════════════════════════════════════════════════════════════════════

atr = ta.atr(atr_len)
atr_pct = atr / close * 100

// Volatility regime classification
atr_values = array.new_float(0)
for i = 0 to math.min(vol_lookback - 1, bar_index)
    array.push(atr_values, atr[i])

atr_sorted = array.copy(atr_values)
array.sort(atr_sorted, order.ascending)

low_vol_index = math.floor(array.size(atr_sorted) * vol_low_percentile / 100)
high_vol_index = math.floor(array.size(atr_sorted) * vol_high_percentile / 100)

low_vol_level = array.size(atr_sorted) > 0 and low_vol_index < array.size(atr_sorted) ? array.get(atr_sorted, low_vol_index) : atr
high_vol_level = array.size(atr_sorted) > 0 and high_vol_index < array.size(atr_sorted) ? array.get(atr_sorted, high_vol_index) : atr

vol_regime = atr < low_vol_level ? "LOW" : atr > high_vol_level ? "HIGH" : "NORMAL"
vol_regime_score = atr < low_vol_level ? 0.3 : atr > high_vol_level ? 0.7 : 1.0

// ═══════════════════════════════════════════════════════════════════════════════
// HTF BIAS & STRENGTH
// ═══════════════════════════════════════════════════════════════════════════════

// Request HTF data with confirmed values (no repainting)
htf_close = request.security(syminfo.tickerid, htf_timeframe, close, lookahead=barmerge.lookahead_off)
htf_high = request.security(syminfo.tickerid, htf_timeframe, high, lookahead=barmerge.lookahead_off)
htf_low = request.security(syminfo.tickerid, htf_timeframe, low, lookahead=barmerge.lookahead_off)
htf_atr = request.security(syminfo.tickerid, htf_timeframe, ta.atr(atr_len), lookahead=barmerge.lookahead_off)

// HTF EMAs
htf_ema_fast = ta.ema(htf_close, htf_fast_len)
htf_ema_slow = ta.ema(htf_close, htf_slow_len)

// HTF bias direction
htf_bias_bull = htf_ema_fast > htf_ema_slow
htf_bias_bear = htf_ema_fast < htf_ema_slow

// HTF strength (normalized by ATR)
htf_separation = math.abs(htf_ema_fast - htf_ema_slow)
htf_strength_raw = htf_atr > 0 ? htf_separation / htf_atr : 0
htf_strength = math.min(htf_strength_raw * 50, 100) // Scale to 0-100

// HTF momentum
htf_roc = ta.roc(htf_close, htf_strength_len)
htf_momentum_score = math.abs(htf_roc) > 0.5 ? math.min(math.abs(htf_roc) * 20, 100) : 0

// Combined HTF score
htf_score = (htf_strength + htf_momentum_score) / 2

// ═══════════════════════════════════════════════════════════════════════════════
// REGIME DETECTION - ADX & EFFICIENCY
// ═══════════════════════════════════════════════════════════════════════════════

// ADX calculation
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0

atr_adx = ta.atr(adx_len)
plus_di = 100 * ta.ema(plus_dm, adx_len) / atr_adx
minus_di = 100 * ta.ema(minus_dm, adx_len) / atr_adx
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx = ta.ema(dx, adx_len)

// Trend classification by ADX
is_trending = adx > adx_trend_threshold
is_strong_trend = adx > adx_strong_threshold
is_choppy = adx < adx_trend_threshold

// Directional efficiency (net displacement / total path)
net_displacement = math.abs(close - close[efficiency_len])
total_path = 0.0
for i = 1 to efficiency_len
    total_path := total_path + math.abs(close[i-1] - close[i])

efficiency = total_path > 0 ? net_displacement / total_path : 0
is_efficient = efficiency > efficiency_threshold

// Combined regime
regime_trending = is_trending and is_efficient
regime_choppy = is_choppy or not is_efficient

// ═══════════════════════════════════════════════════════════════════════════════
// STRUCTURE & PULLBACK LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

// LTF EMAs
ema_f = ta.ema(close, ema_fast)
ema_m = ta.ema(close, ema_mid)
ema_s = ta.ema(close, ema_slow)

// EMA stack alignment
bull_stack = ema_f > ema_m and ema_m > ema_s
bear_stack = ema_f < ema_m and ema_m < ema_s
neutral_stack = not bull_stack and not bear_stack

// Distance from fast EMA (in ATR units)
distance_from_ema = atr > 0 ? (close - ema_f) / atr : 0

// Pullback detection
in_pullback_bull = bull_stack and close < ema_f and distance_from_ema > -pullback_depth_threshold
in_pullback_bear = bear_stack and close > ema_f and distance_from_ema < pullback_depth_threshold

// Extension detection
extended_bull = bull_stack and distance_from_ema > extension_threshold
extended_bear = bear_stack and distance_from_ema < -extension_threshold

// Structure state
structure_state = bull_stack and not in_pullback_bull and not extended_bull ? "Trend Up" :
                  bull_stack and in_pullback_bull ? "Pullback Up" :
                  bull_stack and extended_bull ? "Extended Up" :
                  bear_stack and not in_pullback_bear and not extended_bear ? "Trend Down" :
                  bear_stack and in_pullback_bear ? "Pullback Down" :
                  bear_stack and extended_bear ? "Extended Down" :
                  "Neutral"

// ═══════════════════════════════════════════════════════════════════════════════
// EXHAUSTION & MEAN-REVERSION RISK
// ═══════════════════════════════════════════════════════════════════════════════

// ROC exhaustion
roc_short = ta.roc(close, exhaustion_roc_len)
roc_exhaustion = math.abs(roc_short) > exhaustion_roc_threshold

// Extension exhaustion
extreme_extension = math.abs(distance_from_ema) > exhaustion_extension

// Wick imbalance (body vs total range)
body_size = math.abs(close - open)
total_range = high - low
wick_ratio = total_range > 0 ? body_size / total_range : 1
wick_imbalance = wick_ratio < 0.3 // Large wicks suggest rejection

// Combined exhaustion risk
exhaustion_risk = (roc_exhaustion or extreme_extension or wick_imbalance)

// ═══════════════════════════════════════════════════════════════════════════════
// SESSION QUALITY SCORING
// ═══════════════════════════════════════════════════════════════════════════════

// Session detection (simplified - based on hour in specified timezone)
current_hour = hour(time, session_timezone)

// Asia: 20:00-08:00 (8pm-8am NY time)
// London: 03:00-12:00 (3am-12pm NY time)
// NY: 08:00-17:00 (8am-5pm NY time)
is_asia = current_hour >= 20 or current_hour < 3
is_london = current_hour >= 3 and current_hour < 8
is_ny = current_hour >= 8 and current_hour < 17
is_other = current_hour >= 17 and current_hour < 20

session_quality = is_asia ? asia_quality :
                  is_london ? london_quality :
                  is_ny ? ny_quality :
                  other_quality

session_name = is_asia ? "Asia" :
               is_london ? "London" :
               is_ny ? "NY" :
               "Other"

// Apply session filter
session_multiplier = enable_session_filter ? session_quality : 1.0

// ═══════════════════════════════════════════════════════════════════════════════
// ORDER FLOW PROXY (SAFE PINE-COMPATIBLE)
// ═══════════════════════════════════════════════════════════════════════════════

// Signed volume proxy (close direction * volume)
price_delta = close - close[1]
signed_vol = price_delta > 0 ? volume : price_delta < 0 ? -volume : 0

// Cumulative signed volume over period
signed_vol_sum = ta.sma(signed_vol, 20)
total_vol_sum = ta.sma(volume, 20)

// Volume bias (-1 to +1)
vol_bias = total_vol_sum > 0 ? signed_vol_sum / total_vol_sum : 0

// Volume strength (0 to 1)
vol_strength = math.min(math.abs(vol_bias) * 2, 1.0)

// ═══════════════════════════════════════════════════════════════════════════════
// MARKET STATE CLASSIFICATION
// ═══════════════════════════════════════════════════════════════════════════════

market_state = regime_choppy and vol_regime == "LOW" ? "Compression/Chop" :
               regime_choppy ? "Chop" :
               exhaustion_risk and structure_state == "Extended Up" ? "Exhaustion Up" :
               exhaustion_risk and structure_state == "Extended Down" ? "Exhaustion Down" :
               structure_state == "Trend Up" and is_strong_trend ? "Trend Expansion Up" :
               structure_state == "Pullback Up" ? "Trend Pullback Up" :
               structure_state == "Trend Down" and is_strong_trend ? "Trend Expansion Down" :
               structure_state == "Pullback Down" ? "Trend Pullback Down" :
               structure_state == "Trend Up" ? "Trend Up" :
               structure_state == "Trend Down" ? "Trend Down" :
               "Neutral"

// ═══════════════════════════════════════════════════════════════════════════════
// RISK FLAGS
// ═══════════════════════════════════════════════════════════════════════════════

flag_chop = regime_choppy
flag_low_vol = vol_regime == "LOW"
flag_exhaustion = exhaustion_risk
flag_extended = extended_bull or extended_bear
flag_htf_conflict = (bull_stack and htf_bias_bear) or (bear_stack and htf_bias_bull)

// Combined risk score (0 = clean, 5 = max risk)
risk_count = (flag_chop ? 1 : 0) + (flag_low_vol ? 1 : 0) + (flag_exhaustion ? 1 : 0) + 
             (flag_extended ? 1 : 0) + (flag_htf_conflict ? 1 : 0)

// ═══════════════════════════════════════════════════════════════════════════════
// CONFIRMATION SCORING SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════

// CALL-side confidence components
call_structure = bull_stack ? 30.0 : neutral_stack ? 10.0 : 0.0
call_htf = htf_bias_bull ? htf_score * 0.25 : 0.0
call_regime = regime_trending and plus_di > minus_di ? 20.0 : 0.0
call_vol_flow = vol_bias > 0.2 ? vol_strength * 15.0 : 0.0
call_session = session_multiplier * 10.0

call_confidence_raw = call_structure + call_htf + call_regime + call_vol_flow + call_session

// Apply risk penalties
call_risk_penalty = risk_count * 10.0
call_confidence = math.max(call_confidence_raw - call_risk_penalty, 0.0)

// PUT-side confidence components
put_structure = bear_stack ? 30.0 : neutral_stack ? 10.0 : 0.0
put_htf = htf_bias_bear ? htf_score * 0.25 : 0.0
put_regime = regime_trending and minus_di > plus_di ? 20.0 : 0.0
put_vol_flow = vol_bias < -0.2 ? vol_strength * 15.0 : 0.0
put_session = session_multiplier * 10.0

put_confidence_raw = put_structure + put_htf + put_regime + put_vol_flow + put_session

// Apply risk penalties
put_risk_penalty = risk_count * 10.0
put_confidence = math.max(put_confidence_raw - put_risk_penalty, 0.0)

// ═══════════════════════════════════════════════════════════════════════════════
// DIRECTIONAL BIAS CLASSIFICATION
// ═══════════════════════════════════════════════════════════════════════════════

bias_label = call_confidence > strong_bias_threshold ? "STRONG CALL" :
             call_confidence > weak_bias_threshold ? "WEAK CALL" :
             put_confidence > strong_bias_threshold ? "STRONG PUT" :
             put_confidence > weak_bias_threshold ? "WEAK PUT" :
             "NEUTRAL"

// Stand down condition
stand_down = risk_count >= 3 or vol_regime == "LOW"

// Consensus mode output
consensus = stand_down ? "STAND DOWN" :
            call_confidence > min_confidence and call_confidence > put_confidence ? "CALL OK" :
            put_confidence > min_confidence and put_confidence > call_confidence ? "PUT OK" :
            "WAIT"

// ═══════════════════════════════════════════════════════════════════════════════
// STRATEGY EXECUTION LOGIC
// ═══════════════════════════════════════════════════════════════════════════════
// NOTE: Strategy entries are VALIDATION PROXIES for manual CALL/PUT decisions
// NOT actual broker execution - this simulates holding for 180 seconds
// Use backtest results to evaluate signal quality and market state accuracy
// ═══════════════════════════════════════════════════════════════════════════════

// Determine hold period based on timeframe
current_tf_minutes = timeframe.in_seconds(timeframe.period) / 60
hold_bars = current_tf_minutes <= 0.5 ? hold_bars_15s : hold_bars_30s

// Track bars since last exit for cooldown
var int bars_since_exit = 999

// Entry conditions
long_entry = consensus == "CALL OK" and call_confidence > min_confidence and bars_since_exit > cooldown_bars
short_entry = consensus == "PUT OK" and put_confidence > min_confidence and bars_since_exit > cooldown_bars

// Execute entries
if long_entry
    strategy.entry("CALL_VAL", strategy.long, comment="CALL Validation")
    bars_since_exit := 0

if short_entry
    strategy.entry("PUT_VAL", strategy.short, comment="PUT Validation")
    bars_since_exit := 0

// Time-based exit (simulate 180s expiry)
if strategy.position_size != 0
    bars_in_trade = bar_index - strategy.opentrades.entry_bar_index(0)
    if bars_in_trade >= hold_bars
        if strategy.position_size > 0
            strategy.close("CALL_VAL", comment="CALL Exit")
        else
            strategy.close("PUT_VAL", comment="PUT Exit")

// Increment cooldown counter
if strategy.position_size == 0
    bars_since_exit := bars_since_exit + 1

// ═══════════════════════════════════════════════════════════════════════════════
// VISUAL OUTPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// HTF Ribbon
plot(show_htf_ribbon ? htf_ema_fast : na, "HTF Fast", color=color.new(color.blue, 50), linewidth=2)
plot(show_htf_ribbon ? htf_ema_slow : na, "HTF Slow", color=color.new(color.orange, 50), linewidth=2)

// Background tint by state
bg_color = show_bg_tint and consensus == "CALL OK" ? color.new(color.green, 95) :
           show_bg_tint and consensus == "PUT OK" ? color.new(color.red, 95) :
           show_bg_tint and stand_down ? color.new(color.gray, 97) :
           na
bgcolor(bg_color)

// State transition labels
var string last_consensus = ""
label_text = consensus + "\n" + market_state

if show_state_labels and consensus != last_consensus and consensus != "WAIT"
    label_color = consensus == "CALL OK" ? color.green :
                  consensus == "PUT OK" ? color.red :
                  consensus == "STAND DOWN" ? color.gray :
                  color.yellow
    label.new(bar_index, high, label_text, 
              style=label.style_label_down, 
              color=label_color, 
              textcolor=color.white, 
              size=size.small)
    last_consensus := consensus

// ═══════════════════════════════════════════════════════════════════════════════
// DASHBOARD TABLE
// ═══════════════════════════════════════════════════════════════════════════════

if show_dashboard and barstate.islast
    var table dashboard = table.new(position.top_right, 2, 15, 
                                     border_width=2, 
                                     border_color=color.gray, 
                                     frame_width=1, 
                                     frame_color=color.gray)
    
    // Header
    table.cell(dashboard, 0, 0, "MARKET STATE VALIDATOR", 
               bgcolor=color.new(color.blue, 80), text_color=color.white, text_size=size.normal)
    table.merge_cells(dashboard, 0, 0, 1, 0)
    
    // Consensus
    consensus_color = consensus == "CALL OK" ? color.green :
                      consensus == "PUT OK" ? color.red :
                      consensus == "STAND DOWN" ? color.gray :
                      color.yellow
    table.cell(dashboard, 0, 1, "CONSENSUS", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 1, consensus, bgcolor=color.new(consensus_color, 70), 
               text_color=color.white, text_size=size.normal)
    
    // Bias
    table.cell(dashboard, 0, 2, "Bias", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 2, bias_label, text_size=size.small)
    
    // Confidence scores
    table.cell(dashboard, 0, 3, "CALL Conf", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 3, str.tostring(math.round(call_confidence)), 
               bgcolor=call_confidence > min_confidence ? color.new(color.green, 80) : na, 
               text_size=size.small)
    
    table.cell(dashboard, 0, 4, "PUT Conf", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 4, str.tostring(math.round(put_confidence)), 
               bgcolor=put_confidence > min_confidence ? color.new(color.red, 80) : na, 
               text_size=size.small)
    
    // Market state
    table.cell(dashboard, 0, 5, "Market State", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 5, market_state, text_size=size.small)
    
    // HTF Bias
    htf_text = htf_bias_bull ? "BULL " + str.tostring(math.round(htf_score)) :
               htf_bias_bear ? "BEAR " + str.tostring(math.round(htf_score)) :
               "NEUTRAL"
    table.cell(dashboard, 0, 6, "HTF Bias", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 6, htf_text, text_size=size.small)
    
    // Regime
    table.cell(dashboard, 0, 7, "Regime", bgcolor=color.new(color.gray, 90), text_size=size.small)
    regime_text = regime_trending ? "TREND " + str.tostring(math.round(adx)) : "CHOP " + str.tostring(math.round(adx))
    table.cell(dashboard, 1, 7, regime_text, text_size=size.small)
    
    // Volatility
    table.cell(dashboard, 0, 8, "Volatility", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 8, vol_regime, text_size=size.small)
    
    // Session
    table.cell(dashboard, 0, 9, "Session", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 9, session_name + " (" + str.tostring(math.round(session_quality * 100)) + "%)", 
               text_size=size.small)
    
    // Risk flags header
    table.cell(dashboard, 0, 10, "RISK FLAGS", bgcolor=color.new(color.orange, 80), text_size=size.small)
    table.merge_cells(dashboard, 0, 10, 1, 10)
    
    // Individual risk flags
    table.cell(dashboard, 0, 11, "Chop", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 11, flag_chop ? "⚠" : "✓", 
               text_color=flag_chop ? color.red : color.green, text_size=size.small)
    
    table.cell(dashboard, 0, 12, "Low Vol", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 12, flag_low_vol ? "⚠" : "✓", 
               text_color=flag_low_vol ? color.red : color.green, text_size=size.small)
    
    table.cell(dashboard, 0, 13, "Exhaustion", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 13, flag_exhaustion ? "⚠" : "✓", 
               text_color=flag_exhaustion ? color.red : color.green, text_size=size.small)
    
    table.cell(dashboard, 0, 14, "HTF Conflict", bgcolor=color.new(color.gray, 90), text_size=size.small)
    table.cell(dashboard, 1, 14, flag_htf_conflict ? "⚠" : "✓", 
               text_color=flag_htf_conflict ? color.red : color.green, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// END OF STRATEGY
// ═══════════════════════════════════════════════════════════════════════════════
