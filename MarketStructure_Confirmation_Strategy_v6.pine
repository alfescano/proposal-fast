// @version=6
strategy("Market Structure Confirmation Strategy", 
         shorttitle="MSCS", 
         overlay=true, 
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=10,
         commission_type=strategy.commission.percent, 
         commission_value=0.1,
         slippage=2)

// ═══════════════════════════════════════════════════════════════════════════════
// STRATEGY OVERVIEW
// ═══════════════════════════════════════════════════════════════════════════════
// This is NOT a typical entry signal indicator.
// This is a MARKET STATE VALIDATION ENGINE for 180-second crypto options decisions.
// 
// Strategy entries/exits simulate CALL/PUT validation trades to evaluate:
// - Signal quality
// - Market regime suitability
// - Structural confirmation strength
//
// Use this as a BACKUP/CONFIRMATION layer alongside your primary entry indicator.
// ═══════════════════════════════════════════════════════════════════════════════

// ════════════════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════════════════

// ─── HTF Bias Configuration ───
htf_timeframe = input.timeframe("3", "HTF Timeframe", group="HTF Bias")
htf_fast_len = input.int(8, "HTF Fast EMA", minval=2, group="HTF Bias")
htf_slow_len = input.int(21, "HTF Slow EMA", minval=5, group="HTF Bias")
htf_strength_threshold = input.float(0.3, "HTF Strength Threshold (ATR units)", step=0.1, group="HTF Bias")

// ─── Regime Detection ───
adx_len = input.int(14, "ADX Length", minval=5, group="Regime Detection")
adx_trend_threshold = input.float(25.0, "ADX Trend Threshold", step=1.0, group="Regime Detection")
adx_strong_threshold = input.float(35.0, "ADX Strong Trend Threshold", step=1.0, group="Regime Detection")
atr_len = input.int(14, "ATR Length", minval=5, group="Regime Detection")
efficiency_len = input.int(20, "Directional Efficiency Length", minval=10, group="Regime Detection")

// ─── Structure & Pullback ───
micro_ema_len = input.int(5, "Micro EMA Length", minval=2, group="Structure")
structure_ema_fast = input.int(8, "Structure Fast EMA", minval=3, group="Structure")
structure_ema_mid = input.int(13, "Structure Mid EMA", minval=5, group="Structure")
structure_ema_slow = input.int(21, "Structure Slow EMA", minval=8, group="Structure")
pullback_depth_threshold = input.float(0.4, "Pullback Depth Threshold (ATR)", step=0.1, group="Structure")
extension_threshold = input.float(1.5, "Extension Threshold (ATR units)", step=0.1, group="Structure")

// ─── Exhaustion Detection ───
exhaustion_atr_mult = input.float(2.0, "Exhaustion Distance (ATR mult)", step=0.1, group="Exhaustion")
roc_len = input.int(5, "ROC Length", minval=2, group="Exhaustion")
roc_extreme_threshold = input.float(1.0, "ROC Extreme Threshold %", step=0.1, group="Exhaustion")
wick_body_ratio = input.float(2.0, "Wick/Body Exhaustion Ratio", step=0.1, group="Exhaustion")

// ─── Volatility Regime ───
vol_lookback = input.int(100, "Volatility Lookback", minval=50, group="Volatility")
vol_low_percentile = input.float(30.0, "Low Vol Percentile", step=5.0, group="Volatility")
vol_high_percentile = input.float(70.0, "High Vol Percentile", step=5.0, group="Volatility")

// ─── Session Quality ───
session_scoring = input.bool(true, "Enable Session Scoring", group="Session")
timezone_offset = input.int(0, "Timezone Offset (hours from UTC)", minval=-12, maxval=14, group="Session")
prefer_major_sessions = input.bool(true, "Prefer Major Sessions (London/NY)", group="Session")

// ─── Order Flow Proxy ───
use_volume_proxy = input.bool(true, "Enable Volume Flow Proxy", group="Order Flow")
volume_proxy_len = input.int(10, "Volume Flow Smoothing", minval=3, group="Order Flow")

// ─── Strategy Execution ───
timeframe_seconds = input.int(30, "Chart Timeframe (seconds)", minval=5, group="Strategy Execution", 
                              tooltip="Used to calculate holding period. 30 for 30s chart, 15 for 15s chart")
holding_period_seconds = input.int(180, "Target Holding Period (seconds)", minval=60, group="Strategy Execution",
                                   tooltip="Real-world option expiry duration")
min_confidence_entry = input.int(65, "Minimum Confidence for Entry", minval=50, maxval=95, group="Strategy Execution")
cooldown_bars = input.int(3, "Cooldown Between Trades (bars)", minval=0, group="Strategy Execution")

// ─── Visual Settings ───
show_dashboard = input.bool(true, "Show Dashboard", group="Visuals")
show_state_labels = input.bool(true, "Show State Transition Labels", group="Visuals")
show_background = input.bool(true, "Show State Background Tint", group="Visuals")
show_htf_ribbon = input.bool(true, "Show HTF Bias Ribbon", group="Visuals")

// ─── Test Mode ───
test_mode = input.bool(false, "Test Mode (More Frequent Signals)", group="Test Mode",
                       tooltip="Relaxes thresholds for verification - DO NOT USE IN PRODUCTION")

// ════════════════════════════════════════════════════════════════════════════════
// CORE CALCULATIONS
// ════════════════════════════════════════════════════════════════════════════════

// ─── ATR (volatility baseline) ───
atr = ta.atr(atr_len)
atr_normalized = atr / close

// ─── HTF Bias Calculation ───
htf_fast_ema = request.security(syminfo.tickerid, htf_timeframe, ta.ema(close, htf_fast_len), lookahead=barmerge.lookahead_off)
htf_slow_ema = request.security(syminfo.tickerid, htf_timeframe, ta.ema(close, htf_slow_len), lookahead=barmerge.lookahead_off)
htf_atr = request.security(syminfo.tickerid, htf_timeframe, ta.atr(atr_len), lookahead=barmerge.lookahead_off)

htf_diff = htf_fast_ema - htf_slow_ema
htf_diff_atr_units = htf_diff / htf_atr
htf_bias_bull = htf_diff > 0
htf_bias_bear = htf_diff < 0
htf_bias_strong = math.abs(htf_diff_atr_units) > htf_strength_threshold
htf_bias_weak = math.abs(htf_diff_atr_units) <= htf_strength_threshold

// HTF strength score (0-100)
htf_strength_raw = math.abs(htf_diff_atr_units) / (htf_strength_threshold * 2)
htf_strength_score = math.min(100, htf_strength_raw * 100)

// ─── ADX / DMI (Regime Detection) ───
up_move = high - high[1]
down_move = low[1] - low
plus_dm = up_move > down_move and up_move > 0 ? up_move : 0.0
minus_dm = down_move > up_move and down_move > 0 ? down_move : 0.0

smooth_plus_dm = ta.rma(plus_dm, adx_len)
smooth_minus_dm = ta.rma(minus_dm, adx_len)
smooth_atr = ta.rma(atr, adx_len)

plus_di = 100 * smooth_plus_dm / smooth_atr
minus_di = 100 * smooth_minus_dm / smooth_atr
dx = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx = ta.rma(dx, adx_len)

is_trending = adx > adx_trend_threshold
is_strong_trend = adx > adx_strong_threshold
is_choppy = adx < adx_trend_threshold

// ─── Directional Efficiency ───
// Ratio of net movement to total movement
net_move = math.abs(close - close[efficiency_len])
total_move_sum = 0.0
for i = 1 to efficiency_len
    total_move_sum := total_move_sum + math.abs(close[i-1] - close[i])

directional_efficiency = total_move_sum > 0 ? net_move / total_move_sum : 0.0
efficient_trend = directional_efficiency > 0.5
inefficient_chop = directional_efficiency < 0.3

// ─── Structure EMAs ───
micro_ema = ta.ema(close, micro_ema_len)
struct_fast = ta.ema(close, structure_ema_fast)
struct_mid = ta.ema(close, structure_ema_mid)
struct_slow = ta.ema(close, structure_ema_slow)

// EMA stack alignment
bull_stack = struct_fast > struct_mid and struct_mid > struct_slow
bear_stack = struct_fast < struct_mid and struct_mid < struct_slow
mixed_stack = not bull_stack and not bear_stack

// Distance from micro EMA (mean-reversion risk)
dist_from_micro = (close - micro_ema) / atr
extended_above = dist_from_micro > extension_threshold
extended_below = dist_from_micro < -extension_threshold

// Pullback detection
in_pullback_up = bull_stack and close < struct_mid and dist_from_micro < 0 and dist_from_micro > -pullback_depth_threshold
in_pullback_down = bear_stack and close > struct_mid and dist_from_micro > 0 and dist_from_micro < pullback_depth_threshold

// ─── Exhaustion Detection ───
roc = ta.roc(close, roc_len)
roc_extreme_bull = roc > roc_extreme_threshold
roc_extreme_bear = roc < -roc_extreme_threshold

body_size = math.abs(close - open)
upper_wick = high - math.max(close, open)
lower_wick = math.min(close, open) - low

exhaustion_wick_top = body_size > 0 ? upper_wick / body_size > wick_body_ratio : false
exhaustion_wick_bottom = body_size > 0 ? lower_wick / body_size > wick_body_ratio : false

// Distance from slow EMA (macro exhaustion)
dist_from_slow = (close - struct_slow) / atr
exhausted_above = dist_from_slow > exhaustion_atr_mult
exhausted_below = dist_from_slow < -exhaustion_atr_mult

exhaustion_risk_bull = (roc_extreme_bull and extended_above) or exhausted_above or (exhaustion_wick_top and close > open)
exhaustion_risk_bear = (roc_extreme_bear and extended_below) or exhausted_below or (exhaustion_wick_bottom and close < open)

// ─── Volatility Regime ───
// Calculate percentile ranks
atr_values = array.new_float(vol_lookback)
for i = 0 to vol_lookback - 1
    array.set(atr_values, i, atr[i])

sorted_atr = array.copy(atr_values)
array.sort(sorted_atr, order.ascending)

low_vol_threshold = array.get(sorted_atr, int(vol_lookback * vol_low_percentile / 100))
high_vol_threshold = array.get(sorted_atr, int(vol_lookback * vol_high_percentile / 100))

vol_regime_low = atr < low_vol_threshold
vol_regime_normal = atr >= low_vol_threshold and atr <= high_vol_threshold
vol_regime_high = atr > high_vol_threshold

// ─── Session Detection ───
current_hour_utc = hour(time, "UTC") + timezone_offset
current_hour_adjusted = current_hour_utc < 0 ? current_hour_utc + 24 : current_hour_utc > 23 ? current_hour_utc - 24 : current_hour_utc

in_asian_session = current_hour_adjusted >= 0 and current_hour_adjusted < 8
in_london_session = current_hour_adjusted >= 8 and current_hour_adjusted < 16
in_ny_session = current_hour_adjusted >= 13 and current_hour_adjusted < 22
in_overlap_session = current_hour_adjusted >= 13 and current_hour_adjusted < 16

// Session quality scoring
session_quality = 50.0
if session_scoring
    if in_overlap_session
        session_quality := 100.0
    else if in_london_session or in_ny_session
        session_quality := 80.0
    else if in_asian_session
        session_quality := 60.0
    else
        session_quality := 40.0

session_acceptable = not prefer_major_sessions or in_london_session or in_ny_session or in_overlap_session

// ─── Volume Flow Proxy (Order Flow Approximation) ───
volume_delta_proxy = 0.0
if use_volume_proxy and na(volume) == false
    price_direction = close > close[1] ? 1.0 : close < close[1] ? -1.0 : 0.0
    volume_delta_proxy := ta.ema(price_direction * volume, volume_proxy_len)

volume_flow_bull = volume_delta_proxy > 0
volume_flow_bear = volume_delta_proxy < 0
volume_flow_neutral = math.abs(volume_delta_proxy) < ta.stdev(volume_delta_proxy, volume_proxy_len * 2)

// ════════════════════════════════════════════════════════════════════════════════
// MARKET STATE CLASSIFICATION
// ════════════════════════════════════════════════════════════════════════════════

// State categories
state_trend_expansion_up = bull_stack and is_trending and not in_pullback_up and htf_bias_bull and not extended_above
state_trend_pullback_up = bull_stack and in_pullback_up and htf_bias_bull and not exhaustion_risk_bear
state_trend_expansion_down = bear_stack and is_trending and not in_pullback_down and htf_bias_bear and not extended_below
state_trend_pullback_down = bear_stack and in_pullback_down and htf_bias_bear and not exhaustion_risk_bull
state_compression_chop = is_choppy or inefficient_chop or (vol_regime_low and not is_strong_trend)
state_exhaustion = (exhaustion_risk_bull and close > struct_slow) or (exhaustion_risk_bear and close < struct_slow)
state_reversal_risk = (bull_stack and htf_bias_bear and htf_bias_strong) or (bear_stack and htf_bias_bull and htf_bias_strong)

// State priority (only one state at a time)
market_state = "NEUTRAL"
if state_exhaustion
    market_state := "EXHAUSTION"
else if state_reversal_risk
    market_state := "REVERSAL RISK"
else if state_compression_chop
    market_state := "COMPRESSION"
else if state_trend_expansion_up
    market_state := "EXPANSION UP"
else if state_trend_pullback_up
    market_state := "PULLBACK UP"
else if state_trend_expansion_down
    market_state := "EXPANSION DOWN"
else if state_trend_pullback_down
    market_state := "PULLBACK DOWN"

// ════════════════════════════════════════════════════════════════════════════════
// CONFIDENCE SCORING (0-100 for each direction)
// ════════════════════════════════════════════════════════════════════════════════

// CALL confidence components
call_conf_htf = htf_bias_bull and htf_bias_strong ? 25 : htf_bias_bull and htf_bias_weak ? 15 : 0
call_conf_structure = bull_stack ? 20 : 0
call_conf_regime = is_trending and plus_di > minus_di ? 15 : 0
call_conf_efficiency = efficient_trend and close > close[efficiency_len] ? 10 : 0
call_conf_session = session_acceptable ? 10 : 5
call_conf_volume = use_volume_proxy and volume_flow_bull ? 10 : 5
call_conf_no_exhaustion = not exhaustion_risk_bull ? 10 : 0

call_confidence_raw = call_conf_htf + call_conf_structure + call_conf_regime + call_conf_efficiency + call_conf_session + call_conf_volume + call_conf_no_exhaustion

// Penalties
call_penalty_chop = state_compression_chop ? 30 : 0
call_penalty_reversal = state_reversal_risk ? 25 : 0
call_penalty_exhaustion = exhaustion_risk_bull ? 20 : 0
call_penalty_low_vol = vol_regime_low ? 15 : 0
call_penalty_extended = extended_above ? 10 : 0

call_confidence = math.max(0, call_confidence_raw - call_penalty_chop - call_penalty_reversal - call_penalty_exhaustion - call_penalty_low_vol - call_penalty_extended)

// PUT confidence components
put_conf_htf = htf_bias_bear and htf_bias_strong ? 25 : htf_bias_bear and htf_bias_weak ? 15 : 0
put_conf_structure = bear_stack ? 20 : 0
put_conf_regime = is_trending and minus_di > plus_di ? 15 : 0
put_conf_efficiency = efficient_trend and close < close[efficiency_len] ? 10 : 0
put_conf_session = session_acceptable ? 10 : 5
put_conf_volume = use_volume_proxy and volume_flow_bear ? 10 : 5
put_conf_no_exhaustion = not exhaustion_risk_bear ? 10 : 0

put_confidence_raw = put_conf_htf + put_conf_structure + put_conf_regime + put_conf_efficiency + put_conf_session + put_conf_volume + put_conf_no_exhaustion

// Penalties
put_penalty_chop = state_compression_chop ? 30 : 0
put_penalty_reversal = state_reversal_risk ? 25 : 0
put_penalty_exhaustion = exhaustion_risk_bear ? 20 : 0
put_penalty_low_vol = vol_regime_low ? 15 : 0
put_penalty_extended = extended_below ? 10 : 0

put_confidence = math.max(0, put_confidence_raw - put_penalty_chop - put_penalty_reversal - put_penalty_exhaustion - put_penalty_low_vol - put_penalty_extended)

// Test mode adjustments (lower thresholds)
adjusted_min_confidence = test_mode ? int(min_confidence_entry * 0.75) : min_confidence_entry

// ════════════════════════════════════════════════════════════════════════════════
// BIAS CLASSIFICATION
// ════════════════════════════════════════════════════════════════════════════════

bias_label = "NEUTRAL"
if call_confidence >= 75
    bias_label := "STRONG CALL"
else if call_confidence >= 55 and call_confidence > put_confidence
    bias_label := "WEAK CALL"
else if put_confidence >= 75
    bias_label := "STRONG PUT"
else if put_confidence >= 55 and put_confidence > call_confidence
    bias_label := "WEAK PUT"
else if state_compression_chop or vol_regime_low
    bias_label := "STAND DOWN"

// ════════════════════════════════════════════════════════════════════════════════
// RISK FLAGS
// ════════════════════════════════════════════════════════════════════════════════

risk_chop = state_compression_chop or is_choppy
risk_late_move = extended_above or extended_below or state_exhaustion
risk_low_vol = vol_regime_low
risk_exhaustion = exhaustion_risk_bull or exhaustion_risk_bear
risk_direction_conflict = (htf_bias_bull and bear_stack) or (htf_bias_bear and bull_stack)

// ════════════════════════════════════════════════════════════════════════════════
// CONSENSUS MODE (simplified output)
// ════════════════════════════════════════════════════════════════════════════════

consensus = "WAIT"
if bias_label == "STAND DOWN" or risk_low_vol or (risk_chop and not is_trending)
    consensus := "STAND DOWN"
else if call_confidence >= adjusted_min_confidence and not risk_exhaustion and not risk_late_move
    consensus := "CALL OK"
else if put_confidence >= adjusted_min_confidence and not risk_exhaustion and not risk_late_move
    consensus := "PUT OK"

// ════════════════════════════════════════════════════════════════════════════════
// STRATEGY EXECUTION (Simulated Validation Trades)
// ════════════════════════════════════════════════════════════════════════════════

// Calculate holding period in bars
bars_to_hold = int(holding_period_seconds / timeframe_seconds)

// Track last entry bar for cooldown
var int last_entry_bar = 0
cooldown_expired = bar_index - last_entry_bar >= cooldown_bars

// Entry conditions
long_entry_condition = consensus == "CALL OK" and cooldown_expired and barstate.isconfirmed
short_entry_condition = consensus == "PUT OK" and cooldown_expired and barstate.isconfirmed

// Execute entries
if long_entry_condition
    strategy.entry("CALL_VALIDATION", strategy.long)
    last_entry_bar := bar_index

if short_entry_condition
    strategy.entry("PUT_VALIDATION", strategy.short)
    last_entry_bar := bar_index

// Time-based exits (simulate 180-second expiry)
if strategy.position_size > 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= bars_to_hold
    strategy.close("CALL_VALIDATION", comment="Hold Complete")

if strategy.position_size < 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= bars_to_hold
    strategy.close("PUT_VALIDATION", comment="Hold Complete")

// ════════════════════════════════════════════════════════════════════════════════
// VISUALIZATIONS
// ════════════════════════════════════════════════════════════════════════════════

// ─── HTF Ribbon ───
if show_htf_ribbon
    htf_ribbon_color = htf_bias_bull and htf_bias_strong ? color.new(color.green, 80) : 
                       htf_bias_bear and htf_bias_strong ? color.new(color.red, 80) : 
                       color.new(color.gray, 90)
    plot(htf_fast_ema, "HTF Fast", color=htf_ribbon_color, linewidth=1)
    plot(htf_slow_ema, "HTF Slow", color=htf_ribbon_color, linewidth=1)
    fill_color = htf_bias_bull ? color.new(color.green, 95) : color.new(color.red, 95)
    fill(plot(htf_fast_ema, display=display.none), plot(htf_slow_ema, display=display.none), fill_color)

// ─── Structure EMAs ───
plot(struct_fast, "Fast EMA", color=color.new(color.aqua, 50), linewidth=1)
plot(struct_mid, "Mid EMA", color=color.new(color.orange, 50), linewidth=1)
plot(struct_slow, "Slow EMA", color=color.new(color.purple, 50), linewidth=1)

// ─── Background Tint ───
if show_background
    bg_color = state_trend_expansion_up or state_trend_pullback_up ? color.new(color.green, 97) :
               state_trend_expansion_down or state_trend_pullback_down ? color.new(color.red, 97) :
               state_compression_chop ? color.new(color.yellow, 98) :
               state_exhaustion ? color.new(color.orange, 95) :
               state_reversal_risk ? color.new(color.purple, 96) :
               color.new(color.gray, 99)
    bgcolor(bg_color)

// ─── State Transition Labels ───
state_changed = market_state != market_state[1]
if show_state_labels and state_changed and barstate.isconfirmed
    label_color = market_state == "EXPANSION UP" or market_state == "PULLBACK UP" ? color.green :
                  market_state == "EXPANSION DOWN" or market_state == "PULLBACK DOWN" ? color.red :
                  market_state == "EXHAUSTION" ? color.orange :
                  market_state == "REVERSAL RISK" ? color.purple :
                  color.gray
    label_y_position = market_state == "EXPANSION UP" or market_state == "PULLBACK UP" ? low :
                       market_state == "EXPANSION DOWN" or market_state == "PULLBACK DOWN" ? high :
                       close
    label_style = market_state == "EXPANSION UP" or market_state == "PULLBACK UP" ? label.style_label_up :
                  market_state == "EXPANSION DOWN" or market_state == "PULLBACK DOWN" ? label.style_label_down :
                  label.style_label_center
    label.new(bar_index, label_y_position, market_state, color=label_color, textcolor=color.white, size=size.small, style=label_style)

// ─── Dashboard ───
if show_dashboard
    var table dashboard = table.new(position.top_right, 2, 15, border_width=1)
    
    // Header
    table.cell(dashboard, 0, 0, "METRIC", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 0, "VALUE", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    
    // Consensus
    consensus_color = consensus == "CALL OK" ? color.green :
                      consensus == "PUT OK" ? color.red :
                      consensus == "STAND DOWN" ? color.orange :
                      color.gray
    table.cell(dashboard, 0, 1, "CONSENSUS", text_size=size.normal, bgcolor=color.new(color.gray, 90))
    table.cell(dashboard, 1, 1, consensus, text_size=size.normal, bgcolor=color.new(consensus_color, 70), text_color=color.white)
    
    // Bias
    bias_color = str.contains(bias_label, "CALL") ? color.green :
                 str.contains(bias_label, "PUT") ? color.red :
                 color.gray
    table.cell(dashboard, 0, 2, "Bias", text_size=size.small, bgcolor=color.new(color.gray, 90))
    table.cell(dashboard, 1, 2, bias_label, text_size=size.small, bgcolor=color.new(bias_color, 80), text_color=color.white)
    
    // Market State
    table.cell(dashboard, 0, 3, "Market State", text_size=size.small, bgcolor=color.new(color.gray, 90))
    table.cell(dashboard, 1, 3, market_state, text_size=size.small, text_color=color.white)
    
    // Confidence Scores
    table.cell(dashboard, 0, 4, "CALL Conf", text_size=size.small, bgcolor=color.new(color.gray, 90))
    call_conf_color = call_confidence >= 75 ? color.green : call_confidence >= 55 ? color.yellow : color.gray
    table.cell(dashboard, 1, 4, str.tostring(call_confidence, "#"), text_size=size.small, bgcolor=color.new(call_conf_color, 80))
    
    table.cell(dashboard, 0, 5, "PUT Conf", text_size=size.small, bgcolor=color.new(color.gray, 90))
    put_conf_color = put_confidence >= 75 ? color.red : put_confidence >= 55 ? color.orange : color.gray
    table.cell(dashboard, 1, 5, str.tostring(put_confidence, "#"), text_size=size.small, bgcolor=color.new(put_conf_color, 80))
    
    // HTF
    htf_label = htf_bias_bull ? "BULL" : "BEAR"
    htf_strength_label = htf_bias_strong ? "STRONG" : "WEAK"
    table.cell(dashboard, 0, 6, "HTF Bias", text_size=size.small, bgcolor=color.new(color.gray, 90))
    table.cell(dashboard, 1, 6, htf_label + " (" + htf_strength_label + ")", text_size=size.small, 
               bgcolor=color.new(htf_bias_bull ? color.green : color.red, 85), text_color=color.white)
    
    // Regime
    regime_label = is_strong_trend ? "STRONG TREND" : is_trending ? "TREND" : "CHOP"
    regime_color = is_strong_trend ? color.blue : is_trending ? color.teal : color.yellow
    table.cell(dashboard, 0, 7, "Regime", text_size=size.small, bgcolor=color.new(color.gray, 90))
    table.cell(dashboard, 1, 7, regime_label, text_size=size.small, bgcolor=color.new(regime_color, 80))
    
    // ADX
    table.cell(dashboard, 0, 8, "ADX", text_size=size.small, bgcolor=color.new(color.gray, 90))
    table.cell(dashboard, 1, 8, str.tostring(adx, "#.#"), text_size=size.small)
    
    // Volatility Regime
    vol_label = vol_regime_low ? "LOW" : vol_regime_high ? "HIGH" : "NORMAL"
    vol_color = vol_regime_low ? color.gray : vol_regime_high ? color.orange : color.blue
    table.cell(dashboard, 0, 9, "Vol Regime", text_size=size.small, bgcolor=color.new(color.gray, 90))
    table.cell(dashboard, 1, 9, vol_label, text_size=size.small, bgcolor=color.new(vol_color, 80))
    
    // Session
    session_label = in_overlap_session ? "OVERLAP" : in_london_session ? "LONDON" : in_ny_session ? "NY" : in_asian_session ? "ASIA" : "OTHER"
    table.cell(dashboard, 0, 10, "Session", text_size=size.small, bgcolor=color.new(color.gray, 90))
    table.cell(dashboard, 1, 10, session_label, text_size=size.small)
    
    // Risk Flags
    risk_flags = ""
    if risk_chop
        risk_flags := risk_flags + "CHOP "
    if risk_late_move
        risk_flags := risk_flags + "LATE "
    if risk_low_vol
        risk_flags := risk_flags + "LOWVOL "
    if risk_exhaustion
        risk_flags := risk_flags + "EXHAUST "
    if risk_direction_conflict
        risk_flags := risk_flags + "CONFLICT "
    if risk_flags == ""
        risk_flags := "NONE"
    
    risk_bg_color = risk_flags == "NONE" ? color.green : color.red
    table.cell(dashboard, 0, 11, "Risk Flags", text_size=size.small, bgcolor=color.new(color.gray, 90))
    table.cell(dashboard, 1, 11, risk_flags, text_size=size.tiny, bgcolor=color.new(risk_bg_color, 80), text_color=color.white)
    
    // Directional Efficiency
    table.cell(dashboard, 0, 12, "Dir Efficiency", text_size=size.small, bgcolor=color.new(color.gray, 90))
    table.cell(dashboard, 1, 12, str.tostring(directional_efficiency, "#.##"), text_size=size.small)
    
    // Distance from Micro EMA
    table.cell(dashboard, 0, 13, "Dist μEMA", text_size=size.small, bgcolor=color.new(color.gray, 90))
    dist_color = math.abs(dist_from_micro) > extension_threshold ? color.orange : color.gray
    table.cell(dashboard, 1, 13, str.tostring(dist_from_micro, "#.##") + " ATR", text_size=size.small, bgcolor=color.new(dist_color, 85))
    
    // Strategy Position
    pos_label = strategy.position_size > 0 ? "CALL ACTIVE" : strategy.position_size < 0 ? "PUT ACTIVE" : "NO POSITION"
    pos_color = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dashboard, 0, 14, "Position", text_size=size.small, bgcolor=color.new(color.gray, 90))
    table.cell(dashboard, 1, 14, pos_label, text_size=size.small, bgcolor=color.new(pos_color, 80), text_color=color.white)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(consensus == "CALL OK" and consensus[1] != "CALL OK", "CALL Signal", "CALL OK - Confidence: {{plot_0}}")
alertcondition(consensus == "PUT OK" and consensus[1] != "PUT OK", "PUT Signal", "PUT OK - Confidence: {{plot_1}}")
alertcondition(consensus == "STAND DOWN" and consensus[1] != "STAND DOWN", "Stand Down Alert", "STAND DOWN - Avoid Trading")

// Plot confidence for alert message placeholders
plot(call_confidence, "CALL_Confidence", display=display.none)
plot(put_confidence, "PUT_Confidence", display=display.none)
