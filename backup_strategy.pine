//@version=6
strategy("Backup Market State & Structure Confirmation", shorttitle="Backup State", overlay=true, 
         initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
         commission_type=strategy.commission.percent, commission_value=0.1)

// ============================================================================
// BACKUP STRATEGY FOR MANUAL CRYPTO OPTIONS DECISION SUPPORT
// ============================================================================
// Purpose: Market state + structure confirmation engine for 180s CALL/PUT decisions
// Designed as a BACKUP/VALIDATION layer - not a primary entry signal generator
// Focus: Accuracy > Frequency | Structure-aware | Macro context
// ============================================================================

// ============================================================================
// INPUTS SECTION
// ============================================================================

// --- Chart Timeframe Settings ---
htf_multiplier = input.int(6, "HTF Multiplier", minval=2, maxval=20, 
                           tooltip="Higher timeframe multiplier (e.g., 6 = 3m on 30s chart)")
htf_source = input.source(close, "HTF Source", tooltip="Source for HTF calculations")

// --- HTF Bias Settings ---
htf_fast_ema = input.int(21, "HTF Fast EMA", minval=5, maxval=100)
htf_slow_ema = input.int(50, "HTF Slow EMA", minval=20, maxval=200)
htf_strength_threshold = input.float(1.5, "HTF Strength Threshold (ATR)", minval=0.5, maxval=5.0, step=0.1,
                                      tooltip="HTF trend strength threshold in ATR units")

// --- Regime Detection Settings ---
adx_length = input.int(14, "ADX Length", minval=5, maxval=30)
adx_trend_threshold = input.float(20.0, "ADX Trend Threshold", minval=10.0, maxval=40.0, step=1.0)
atr_length = input.int(14, "ATR Length", minval=5, maxval=30)
atr_expansion_factor = input.float(1.3, "ATR Expansion Factor", minval=1.0, maxval=2.0, step=0.1)
efficiency_length = input.int(20, "Efficiency Length", minval=10, maxval=50)
efficiency_threshold = input.float(0.4, "Efficiency Threshold", minval=0.2, maxval=0.8, step=0.05,
                                    tooltip="Directional efficiency ratio threshold")

// --- Structure / Pullback Settings ---
structure_ema_fast = input.int(9, "Structure Fast EMA", minval=5, maxval=30)
structure_ema_slow = input.int(21, "Structure Slow EMA", minval=10, maxval=50)
pullback_atr_mult = input.float(1.0, "Pullback Depth (ATR)", minval=0.5, maxval=2.5, step=0.1)
extension_atr_mult = input.float(2.5, "Extension Warning (ATR)", minval=1.5, maxval=4.0, step=0.1,
                                  tooltip="Price extension from mean that triggers exhaustion warning")

// --- Exhaustion Detection ---
exhaustion_roc_length = input.int(10, "Exhaustion ROC Length", minval=5, maxval=20)
exhaustion_roc_threshold = input.float(2.0, "Exhaustion ROC Threshold (%)", minval=1.0, maxval=5.0, step=0.1)
wick_body_ratio = input.float(2.0, "Wick/Body Exhaustion Ratio", minval=1.5, maxval=4.0, step=0.1)

// --- Volatility Regime Settings ---
vol_low_threshold = input.float(0.7, "Low Vol Threshold (ATR ratio)", minval=0.3, maxval=1.2, step=0.1)
vol_high_threshold = input.float(1.5, "High Vol Threshold (ATR ratio)", minval=1.0, maxval=3.0, step=0.1)
vol_lookback = input.int(50, "Volatility Lookback", minval=20, maxval=100)

// --- Session Settings ---
use_session_filter = input.bool(true, "Enable Session Filter", tooltip="Filter signals by trading session quality")
session_timezone = input.string("America/New_York", "Session Timezone", 
                                options=["America/New_York", "Europe/London", "Asia/Tokyo", "UTC"])
prefer_ny_session = input.bool(true, "Prefer NY Session", tooltip="Higher confidence during NY session")

// --- Order Flow Proxy (Signed Volume) ---
use_orderflow = input.bool(true, "Enable Order Flow Proxy", tooltip="Use signed volume as confidence modifier")
orderflow_length = input.int(20, "Order Flow Length", minval=10, maxval=50)

// --- Strategy Simulation Settings ---
hold_bars_30s = input.int(6, "Hold Bars (30s chart)", minval=3, maxval=12, 
                          tooltip="Number of bars to hold (6 bars = 180 seconds on 30s chart)")
cooldown_bars = input.int(3, "Cooldown Bars", minval=0, maxval=10,
                          tooltip="Minimum bars between strategy entries")
min_confidence = input.int(60, "Min Confidence Score", minval=40, maxval=90, step=5,
                           tooltip="Minimum confidence score to trigger strategy entry")

// --- Display Settings ---
show_labels = input.bool(true, "Show State Labels")
show_table = input.bool(true, "Show Dashboard Table")
show_htf_ribbon = input.bool(true, "Show HTF Bias Ribbon")
show_background = input.bool(true, "Show Background Tint")
test_mode = input.bool(false, "Test Mode (More Frequent Updates)", 
                       tooltip="Lower thresholds for testing/verification")

// ============================================================================
// HELPER FUNCTIONS (Pine v6 Safe)
// ============================================================================

// Get HTF timeframe string
htf_timeframe = timeframe.multiplier >= htf_multiplier ? timeframe.period : str.tostring(htf_multiplier) + timeframe.period

// Normalize value to 0-100 range
normalize(val, min_val, max_val) =>
    math.max(0, math.min(100, (val - min_val) / (max_val - min_val) * 100))

// Calculate directional efficiency ratio
calc_efficiency(src, len) =>
    total_move = math.sum(math.abs(src - src[1]), len)
    net_move = math.abs(src - src[len])
    efficiency = total_move > 0 ? net_move / total_move : 0.5
    efficiency

// Calculate signed volume proxy (order flow)
calc_signed_volume(len) =>
    signed_vol = 0.0
    for i = 0 to len - 1
        price_change = close[i] - close[i + 1]
        vol_sign = price_change > 0 ? 1 : price_change < 0 ? -1 : 0
        signed_vol := signed_vol + vol_sign * volume[i]
    signed_vol

// Session detection
get_session() =>
    hour_ny = hour(time, session_timezone)
    hour_london = hour(time, "Europe/London")
    hour_asia = hour(time, "Asia/Tokyo")
    
    ny_active = hour_ny >= 8 and hour_ny < 17
    london_active = hour_london >= 8 and hour_london < 17
    asia_active = hour_asia >= 8 and hour_asia < 17
    
    session_score = 0.0
    session_name = "Other"
    
    if ny_active
        session_score := prefer_ny_session ? 1.0 : 0.8
        session_name := "NY"
    else if london_active
        session_score := 0.7
        session_name := "London"
    else if asia_active
        session_score := 0.6
        session_name := "Asia"
    else
        session_score := 0.4
        session_name := "Other"
    
    [session_score, session_name]

// ============================================================================
// HTF DATA FETCHING (NON-REPAINTING)
// ============================================================================

// Fetch HTF data - only confirmed bars
[htf_close, htf_high, htf_low] = request.security(syminfo.tickerid, htf_timeframe, 
    [close, high, low], lookahead=barmerge.lookahead_off)

// HTF EMAs
htf_fast_ema_val = request.security(syminfo.tickerid, htf_timeframe,
    ta.ema(htf_source, htf_fast_ema), lookahead=barmerge.lookahead_off)
htf_slow_ema_val = request.security(syminfo.tickerid, htf_timeframe,
    ta.ema(htf_source, htf_slow_ema), lookahead=barmerge.lookahead_off)

// HTF ATR for normalization
htf_atr = request.security(syminfo.tickerid, htf_timeframe,
    ta.atr(atr_length), lookahead=barmerge.lookahead_off)

// HTF Bias Direction
htf_bullish = htf_fast_ema_val > htf_slow_ema_val
htf_bearish = htf_fast_ema_val < htf_slow_ema_val
htf_neutral = not htf_bullish and not htf_bearish

// HTF Strength (distance between EMAs normalized by ATR)
htf_ema_distance = math.abs(htf_fast_ema_val - htf_slow_ema_val)
htf_strength = htf_atr > 0 ? htf_ema_distance / htf_atr : 0.0
htf_strong = htf_strength >= htf_strength_threshold

// HTF Bias Score (-100 to +100)
htf_bias_score = htf_bullish ? (htf_strong ? 75.0 : 40.0) : htf_bearish ? (htf_strong ? -75.0 : -40.0) : 0.0

// ============================================================================
// REGIME DETECTION (TREND vs CHOP)
// ============================================================================

// ADX / DMI
[di_plus, di_minus, adx_val] = ta.dmi(adx_length, adx_length)
in_trend_regime = adx_val >= adx_trend_threshold
trend_direction = di_plus > di_minus ? 1 : di_minus > di_plus ? -1 : 0

// ATR Expansion/Compression
current_atr = ta.atr(atr_length)
atr_sma = ta.sma(current_atr, vol_lookback)
atr_ratio = atr_sma > 0 ? current_atr / atr_sma : 1.0
atr_expanded = atr_ratio >= atr_expansion_factor
atr_compressed = atr_ratio <= vol_low_threshold

// Directional Efficiency
efficiency = calc_efficiency(close, efficiency_length)
efficient_move = efficiency >= efficiency_threshold

// Regime Classification
in_chop = not in_trend_regime and not efficient_move
in_clean_trend = in_trend_regime and efficient_move and atr_expanded
in_compression = atr_compressed and not efficient_move

// Regime Score (-100 to +100, 0 = chop)
regime_score = in_clean_trend ? (trend_direction * 60.0) : in_chop ? 0.0 : trend_direction * 30.0

// ============================================================================
// STRUCTURE / PULLBACK LOGIC
// ============================================================================

// Structure EMAs
struct_fast = ta.ema(close, structure_ema_fast)
struct_slow = ta.ema(close, structure_ema_slow)

// EMA Stack Slope
ema_slope_fast = struct_fast - struct_fast[5]
ema_slope_slow = struct_slow - struct_slow[5]
slope_bullish = ema_slope_fast > 0 and ema_slope_slow > 0
slope_bearish = ema_slope_fast < 0 and ema_slope_slow < 0

// Distance from Micro EMA (structure mean)
micro_ema = ta.ema(close, 5)
distance_from_mean = close - micro_ema
distance_atr = current_atr > 0 ? distance_from_mean / current_atr : 0.0

// Pullback Detection
in_pullback_up = htf_bullish and close < struct_fast and close > struct_slow and distance_atr > -pullback_atr_mult and distance_atr < 0
in_pullback_down = htf_bearish and close > struct_fast and close < struct_slow and distance_atr < pullback_atr_mult and distance_atr > 0

// Structure State
structure_bullish = slope_bullish and close > struct_slow
structure_bearish = slope_bearish and close < struct_slow
structure_neutral = not structure_bullish and not structure_bearish

// Structure Score
structure_score = structure_bullish ? 50.0 : structure_bearish ? -50.0 : 0.0
if in_pullback_up
    structure_score := 30.0  // Pullback within uptrend
if in_pullback_down
    structure_score := -30.0  // Pullback within downtrend

// ============================================================================
// EXHAUSTION / MEAN-REVERSION RISK DETECTION
// ============================================================================

// Price Extension from Mean
price_extended_up = distance_atr >= extension_atr_mult
price_extended_down = distance_atr <= -extension_atr_mult
price_extended = price_extended_up or price_extended_down

// ROC Extreme
roc_val = ta.roc(close, exhaustion_roc_length)
roc_extreme_up = roc_val >= exhaustion_roc_threshold
roc_extreme_down = roc_val <= -exhaustion_roc_threshold
roc_extreme = roc_extreme_up or roc_extreme_down

// Wick/Body Imbalance
body_size = math.abs(close - open)
upper_wick = high - math.max(close, open)
lower_wick = math.min(close, open) - low
max_wick = math.max(upper_wick, lower_wick)
wick_body_imbalance = body_size > 0 ? max_wick / body_size : 0.0
exhaustion_wick = wick_body_imbalance >= wick_body_ratio

// Volatility Spike After Push
vol_spike = atr_ratio >= vol_high_threshold and roc_extreme

// Exhaustion Flags
exhaustion_risk_up = price_extended_up or (roc_extreme_up and exhaustion_wick)
exhaustion_risk_down = price_extended_down or (roc_extreme_down and exhaustion_wick)
exhaustion_risk = exhaustion_risk_up or exhaustion_risk_down or vol_spike

// Exhaustion Penalty (reduces confidence)
exhaustion_penalty = exhaustion_risk ? 30.0 : 0.0

// ============================================================================
// VOLATILITY REGIME CLASSIFICATION
// ============================================================================

vol_regime = atr_ratio <= vol_low_threshold ? "LOW" : atr_ratio >= vol_high_threshold ? "HIGH" : "NORMAL"
vol_score = vol_regime == "LOW" ? -20.0 : vol_regime == "HIGH" ? 10.0 : 0.0

// ============================================================================
// ORDER FLOW PROXY (SIGNED VOLUME)
// ============================================================================

signed_vol = use_orderflow ? calc_signed_volume(orderflow_length) : 0.0
signed_vol_sma = ta.sma(math.abs(signed_vol), orderflow_length)
orderflow_ratio = signed_vol_sma > 0 ? signed_vol / signed_vol_sma : 0.0
orderflow_bullish = orderflow_ratio > 0.3
orderflow_bearish = orderflow_ratio < -0.3
orderflow_score = use_orderflow ? math.max(-25.0, math.min(25.0, orderflow_ratio * 50.0)) : 0.0

// ============================================================================
// SESSION QUALITY SCORING
// ============================================================================

[session_quality, session_name] = get_session()
session_score = use_session_filter ? (session_quality - 0.5) * 20.0 : 0.0

// ============================================================================
// COMPOSITE BIAS CALCULATION
// ============================================================================

// Combine all components (weights can be adjusted)
base_bias = htf_bias_score * 0.35 + regime_score * 0.25 + structure_score * 0.20 + orderflow_score * 0.10 + session_score * 0.10

// Apply exhaustion penalty
final_bias = base_bias - (exhaustion_risk_up and base_bias > 0 ? exhaustion_penalty : 0.0) - 
                        (exhaustion_risk_down and base_bias < 0 ? exhaustion_penalty : 0.0)

// Apply volatility adjustment
final_bias := final_bias + vol_score

// Normalize to -100 to +100 range
final_bias := math.max(-100, math.min(100, final_bias))

// Separate Call/Put Confidence Scores (0-100)
call_confidence = final_bias > 0 ? normalize(final_bias, 0, 100) : 0.0
put_confidence = final_bias < 0 ? normalize(math.abs(final_bias), 0, 100) : 0.0

// Test mode adjustment (lower thresholds)
call_conf_display = test_mode ? call_confidence * 1.2 : call_confidence
put_conf_display = test_mode ? put_confidence * 1.2 : put_confidence
call_conf_display := math.min(100, call_conf_display)
put_conf_display := math.min(100, put_conf_display)

// ============================================================================
// MARKET STATE CLASSIFICATION
// ============================================================================

// Determine primary market state
market_state = "NEUTRAL"
state_color = color.gray

if in_chop or in_compression
    market_state := "CHOP / COMPRESSION"
    state_color := color.orange
else if exhaustion_risk
    if htf_bullish and exhaustion_risk_up
        market_state := "EXHAUSTION UP"
        state_color := color.yellow
    else if htf_bearish and exhaustion_risk_down
        market_state := "EXHAUSTION DOWN"
        state_color := color.yellow
    else
        market_state := "EXHAUSTION RISK"
        state_color := color.yellow
else if in_clean_trend
    if trend_direction == 1
        if in_pullback_up
            market_state := "TREND PULLBACK UP"
            state_color := color.blue
        else
            market_state := "TREND EXPANSION UP"
            state_color := color.lime
    else if trend_direction == -1
        if in_pullback_down
            market_state := "TREND PULLBACK DOWN"
            state_color := color.blue
        else
            market_state := "TREND EXPANSION DOWN"
            state_color := color.red
else if htf_bullish and structure_bullish
    market_state := "TREND PULLBACK UP"
    state_color := color.blue
else if htf_bearish and structure_bearish
    market_state := "TREND PULLBACK DOWN"
    state_color := color.blue

// ============================================================================
// BIAS CLASSIFICATION (STRONG CALL / PUT / NEUTRAL / STAND DOWN)
// ============================================================================

bias_state = "NEUTRAL"
bias_color = color.gray
stand_down = false

if vol_regime == "LOW"
    bias_state := "STAND DOWN"
    bias_color := color.orange
    stand_down := true
else if exhaustion_risk and math.abs(final_bias) < 30
    bias_state := "STAND DOWN"
    bias_color := color.orange
    stand_down := true
else if call_conf_display >= 70
    bias_state := "STRONG CALL BIAS"
    bias_color := color.lime
else if call_conf_display >= 50
    bias_state := "WEAK CALL BIAS"
    bias_color := color.aqua
else if put_conf_display >= 70
    bias_state := "STRONG PUT BIAS"
    bias_color := color.red
else if put_conf_display >= 50
    bias_state := "WEAK PUT BIAS"
    bias_color := color.orange
else
    bias_state := "NEUTRAL / CHOP"
    bias_color := color.gray

// ============================================================================
// RISK FLAGS
// ============================================================================

risk_chop = in_chop or in_compression
risk_late_move = exhaustion_risk
risk_low_vol = vol_regime == "LOW"
risk_exhaustion = exhaustion_risk
risk_direction_conflict = (htf_bullish and structure_bearish) or (htf_bearish and structure_bullish)

// ============================================================================
// CONSENSUS MODE (SIMPLIFIED OUTPUT)
// ============================================================================

consensus = "WAIT"
if stand_down
    consensus := "STAND DOWN"
else if call_conf_display >= min_confidence and not risk_direction_conflict and not risk_exhaustion
    consensus := "CALL OK"
else if put_conf_display >= min_confidence and not risk_direction_conflict and not risk_exhaustion
    consensus := "PUT OK"
else
    consensus := "WAIT"

// ============================================================================
// STRATEGY LOGIC (SIMULATION FOR VALIDATION)
// ============================================================================

// Calculate hold duration based on timeframe
current_tf_minutes = timeframe.in_seconds() / 60.0
bars_to_hold = math.round(180 / (current_tf_minutes * 60))  // 180 seconds
bars_to_hold := math.max(3, math.min(20, bars_to_hold))  // Clamp between 3-20 bars

// Entry conditions
can_enter_call = consensus == "CALL OK" and not risk_direction_conflict and not risk_exhaustion
can_enter_put = consensus == "PUT OK" and not risk_direction_conflict and not risk_exhaustion

// Cooldown tracking
var int last_entry_bar = 0
bars_since_entry = bar_index - last_entry_bar

// Strategy entries (simulation only - for validation)
if can_enter_call and bars_since_entry >= cooldown_bars and strategy.position_size == 0
    strategy.entry("CALL_VALIDATION", strategy.long, comment="CALL OK")
    last_entry_bar := bar_index

if can_enter_put and bars_since_entry >= cooldown_bars and strategy.position_size == 0
    strategy.entry("PUT_VALIDATION", strategy.short, comment="PUT OK")
    last_entry_bar := bar_index

// Strategy exit (time-based, simulating 180-second hold)
if strategy.position_size != 0
    if strategy.opentrades.entry_bar_index(0) + bars_to_hold <= bar_index
        strategy.close("CALL_VALIDATION", comment="180s Exit")
        strategy.close("PUT_VALIDATION", comment="180s Exit")

// ============================================================================
// VISUALS
// ============================================================================

// Background tint
bg_color = show_background ? (bias_state == "STRONG CALL BIAS" ? color.new(color.lime, 95) : 
                              bias_state == "STRONG PUT BIAS" ? color.new(color.red, 95) : 
                              bias_state == "STAND DOWN" ? color.new(color.orange, 97) : na) : na
plotshape(show_background and not na(bg_color), style=shape.square, location=location.absolute, 
          color=bg_color, size=size.huge)

// HTF Bias Ribbon
ribbon_top = show_htf_ribbon ? htf_fast_ema_val : na
ribbon_bottom = show_htf_ribbon ? htf_slow_ema_val : na
ribbon_color = htf_bullish ? color.new(color.blue, 70) : htf_bearish ? color.new(color.red, 70) : color.new(color.gray, 80)
plot(ribbon_top, "HTF Fast EMA", color=ribbon_color, linewidth=1, display=display.none)
plot(ribbon_bottom, "HTF Slow EMA", color=ribbon_color, linewidth=1, display=display.none)
fill(plot(ribbon_top), plot(ribbon_bottom), color=ribbon_color, title="HTF Bias")

// State labels
label_text = bias_state + "\n" + market_state + "\nCall: " + str.tostring(math.round(call_conf_display)) + 
             "% | Put: " + str.tostring(math.round(put_conf_display)) + "%\n" + consensus
label_color = bias_color
label_style = bias_state == "STRONG CALL BIAS" or bias_state == "STRONG PUT BIAS" ? label.style_label_up : 
              bias_state == "STAND DOWN" ? label.style_label_down : label.style_label_center

if show_labels and barstate.islast
    var label state_label = label.new(bar_index, high, text=label_text, 
                                       color=label_color, textcolor=color.white, 
                                       style=label_style, size=size.normal)
    label.set_xy(state_label, bar_index, high)
    label.set_text(state_label, label_text)
    label.set_color(state_label, label_color)
    label.set_style(state_label, label_style)

// Dashboard Table
if show_table and barstate.islast
    var table dashboard = table.new(position.top_right, 2, 15, bgcolor=color.new(color.black, 10), 
                                    border_width=1, border_color=color.gray)
    
    // Header
    table.cell(dashboard, 0, 0, "BACKUP STRATEGY", text_color=color.white, bgcolor=color.new(color.blue, 20), text_size=size.normal)
    table.cell(dashboard, 1, 0, "VALUE", text_color=color.white, bgcolor=color.new(color.blue, 20), text_size=size.normal)
    
    // Bias State
    table.cell(dashboard, 0, 1, "BIAS STATE", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 1, bias_state, text_color=bias_color, text_size=size.small)
    
    // Consensus
    table.cell(dashboard, 0, 2, "CONSENSUS", text_color=color.white, text_size=size.small)
    consensus_color = consensus == "CALL OK" ? color.lime : consensus == "PUT OK" ? color.red : 
                      consensus == "STAND DOWN" ? color.orange : color.gray
    table.cell(dashboard, 1, 2, consensus, text_color=consensus_color, text_size=size.normal)
    
    // Confidence Scores
    table.cell(dashboard, 0, 3, "CALL CONF", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 3, str.tostring(math.round(call_conf_display)) + "%", 
               text_color=call_conf_display >= 70 ? color.lime : call_conf_display >= 50 ? color.aqua : color.gray, 
               text_size=size.small)
    
    table.cell(dashboard, 0, 4, "PUT CONF", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 4, str.tostring(math.round(put_conf_display)) + "%", 
               text_color=put_conf_display >= 70 ? color.red : put_conf_display >= 50 ? color.orange : color.gray, 
               text_size=size.small)
    
    // Market State
    table.cell(dashboard, 0, 5, "MARKET STATE", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 5, market_state, text_color=state_color, text_size=size.small)
    
    // HTF Bias
    table.cell(dashboard, 0, 6, "HTF BIAS", text_color=color.white, text_size=size.small)
    htf_bias_text = htf_bullish ? "BULL " + str.tostring(math.round(htf_strength * 10) / 10) : 
                     htf_bearish ? "BEAR " + str.tostring(math.round(htf_strength * 10) / 10) : "NEUTRAL"
    table.cell(dashboard, 1, 6, htf_bias_text, 
               text_color=htf_bullish ? color.lime : htf_bearish ? color.red : color.gray, text_size=size.small)
    
    // Regime
    table.cell(dashboard, 0, 7, "REGIME", text_color=color.white, text_size=size.small)
    regime_text = in_clean_trend ? "TREND" : in_chop ? "CHOP" : "MIXED"
    table.cell(dashboard, 1, 7, regime_text, 
               text_color=in_clean_trend ? color.lime : in_chop ? color.orange : color.gray, text_size=size.small)
    
    // Volatility
    table.cell(dashboard, 0, 8, "VOLATILITY", text_color=color.white, text_size=size.small)
    vol_color = vol_regime == "HIGH" ? color.yellow : vol_regime == "LOW" ? color.orange : color.gray
    table.cell(dashboard, 1, 8, vol_regime, text_color=vol_color, text_size=size.small)
    
    // ADX
    table.cell(dashboard, 0, 9, "ADX", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 9, str.tostring(math.round(adx_val)), 
               text_color=in_trend_regime ? color.lime : color.gray, text_size=size.small)
    
    // Session
    table.cell(dashboard, 0, 10, "SESSION", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 10, session_name, text_color=color.white, text_size=size.small)
    
    // Risk Flags
    table.cell(dashboard, 0, 11, "RISK FLAGS", text_color=color.white, text_size=size.small)
    risk_text = (risk_chop ? "CHOP " : "") + (risk_late_move ? "LATE " : "") + 
                (risk_low_vol ? "LOW_VOL " : "") + (risk_exhaustion ? "EXH " : "") + 
                (risk_direction_conflict ? "CONFLICT" : "")
    risk_text := risk_text == "" ? "NONE" : risk_text
    risk_flag_color = risk_text != "NONE" ? color.orange : color.gray
    table.cell(dashboard, 1, 11, risk_text, text_color=risk_flag_color, text_size=size.tiny)
    
    // Efficiency
    table.cell(dashboard, 0, 12, "EFFICIENCY", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 12, str.tostring(math.round(efficiency * 100)) + "%", 
               text_color=efficient_move ? color.lime : color.gray, text_size=size.small)
    
    // Order Flow
    if use_orderflow
        table.cell(dashboard, 0, 13, "ORDER FLOW", text_color=color.white, text_size=size.small)
        of_color = orderflow_bullish ? color.lime : orderflow_bearish ? color.red : color.gray
        table.cell(dashboard, 1, 13, orderflow_bullish ? "BULL" : orderflow_bearish ? "BEAR" : "NEUTRAL", 
                   text_color=of_color, text_size=size.small)
    
    // HTF Timeframe
    table.cell(dashboard, 0, 14, "HTF", text_color=color.white, text_size=size.small)
    table.cell(dashboard, 1, 14, htf_timeframe, text_color=color.white, text_size=size.small)
