//@version=6
strategy("Backup Market State Validator (180s Options)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
htfTimeframe = input.timeframe("3", "HTF Timeframe")
holdSeconds = input.int(180, "Simulated Hold (seconds)", minval=60, step=30)
cooldownBarsInput = input.int(2, "Cooldown Bars", minval=0)

emaFastLen = input.int(21, "LTF EMA Fast", minval=5)
emaMidLen = input.int(50, "LTF EMA Mid", minval=10)
emaSlowLen = input.int(100, "LTF EMA Slow", minval=20)
slopeLookback = input.int(8, "EMA Slope Lookback", minval=3)

htfFastLen = input.int(21, "HTF EMA Fast", minval=5)
htfSlowLen = input.int(55, "HTF EMA Slow", minval=10)
htfStrengthMax = input.float(1.8, "HTF Strength Max (ATR)", minval=0.5, step=0.1)

atrLen = input.int(14, "ATR Length", minval=5)
atrBasisLen = input.int(50, "ATR Basis Length", minval=20)
atrLowThresh = input.float(0.8, "ATR Low Threshold", minval=0.4, step=0.05)
atrHighThresh = input.float(1.4, "ATR High Threshold", minval=1.0, step=0.05)

adxLen = input.int(14, "ADX Length", minval=5)
adxTrendThresh = input.float(18, "ADX Trend Threshold", minval=10)
adxChopThresh = input.float(14, "ADX Chop Threshold", minval=8)

erLen = input.int(20, "Efficiency Ratio Length", minval=10)
erTrendThresh = input.float(0.35, "Efficiency Trend Threshold", minval=0.1, step=0.05)
erChopThresh = input.float(0.25, "Efficiency Chop Threshold", minval=0.1, step=0.05)

extensionThresh = input.float(2.2, "Extension Threshold (ATR)", minval=1.0, step=0.1)
rocLen = input.int(6, "ROC Length", minval=2)
rocThresh = input.float(0.55, "ROC Extreme Threshold (%)", minval=0.2, step=0.05)
wickThresh = input.float(0.55, "Wick Imbalance Threshold", minval=0.2, step=0.05)

oflowLen = input.int(14, "Order-Flow Proxy Length", minval=5)

sessionTimezone = input.string("Etc/UTC", "Session Timezone")
sessionAsia = input.session("0000-0600", "Asia Session")
sessionLondon = input.session("0700-1100", "London Session")
sessionNY = input.session("1230-1700", "NY Session")

entryScoreThresh = input.int(68, "Entry Score Threshold", minval=50, maxval=90)
strongBiasThresh = input.int(70, "Strong Bias Threshold", minval=55, maxval=90)
weakBiasThresh = input.int(55, "Weak Bias Threshold", minval=45, maxval=80)

showBackground = input.bool(true, "Background Tint")
showHtfRibbon = input.bool(true, "Show HTF EMA Ribbon")

// -----------------------------------------------------------------------------
// Helper
// -----------------------------------------------------------------------------
f_clamp(x, minVal, maxVal) => math.min(math.max(x, minVal), maxVal)

// -----------------------------------------------------------------------------
// Core Calculations
// -----------------------------------------------------------------------------
emaFast = ta.ema(close, emaFastLen)
emaMid = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)

atr = ta.atr(atrLen)
atrBasis = ta.sma(atr, atrBasisLen)
atrRatio = atrBasis == 0 ? 1 : atr / atrBasis

adxValue = ta.adx(adxLen)

erDenom = ta.sma(math.abs(close - close[1]), erLen) * erLen
efficiency = erDenom == 0 ? 0 : math.abs(close - close[erLen]) / erDenom

htfEmaFast = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, htfFastLen), barmerge.gaps_off, barmerge.lookahead_off)
htfEmaSlow = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, htfSlowLen), barmerge.gaps_off, barmerge.lookahead_off)
htfAtr = request.security(syminfo.tickerid, htfTimeframe, ta.atr(atrLen), barmerge.gaps_off, barmerge.lookahead_off)

htfTrendUp = htfEmaFast > htfEmaSlow
htfTrendDown = htfEmaFast < htfEmaSlow
htfStrength = htfAtr == 0 ? 0 : math.abs(htfEmaFast - htfEmaSlow) / htfAtr
htfStrengthNorm = f_clamp(htfStrength / htfStrengthMax, 0, 1)

emaSlopeUp = emaFast > emaFast[slopeLookback]
emaSlopeDown = emaFast < emaFast[slopeLookback]

ltfTrendUp = emaFast > emaMid and emaMid > emaSlow and emaSlopeUp
ltfTrendDown = emaFast < emaMid and emaMid < emaSlow and emaSlopeDown

pullbackUp = emaFast > emaSlow and close < emaFast and close > emaSlow
pullbackDown = emaFast < emaSlow and close > emaFast and close < emaSlow

trendRegime = adxValue > adxTrendThresh and efficiency > erTrendThresh
chopRisk = adxValue < adxChopThresh or efficiency < erChopThresh or atrRatio < atrLowThresh

lowVol = atrRatio < atrLowThresh
highVol = atrRatio > atrHighThresh

extension = atr == 0 ? 0 : math.abs(close - emaFast) / atr
rocValue = math.abs(ta.roc(close, rocLen))
hlRange = math.max(high - low, syminfo.mintick)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
wickImbalance = (upperWick + lowerWick) / hlRange
exhaustionRisk = extension > extensionThresh and (rocValue > rocThresh or wickImbalance > wickThresh)

directionConflict = (htfTrendUp and ltfTrendDown) or (htfTrendDown and ltfTrendUp)

signedVolume = volume * math.sign(close - close[1])
oflowBase = ta.sma(signedVolume, oflowLen)
oflowNorm = ta.sma(volume, oflowLen)
orderflow = oflowNorm == 0 ? 0 : oflowBase / oflowNorm

// -----------------------------------------------------------------------------
// Session Quality
// -----------------------------------------------------------------------------
inAsia = not na(time(timeframe.period, sessionAsia, sessionTimezone))
inLondon = not na(time(timeframe.period, sessionLondon, sessionTimezone))
inNY = not na(time(timeframe.period, sessionNY, sessionTimezone))

sessionScore = inNY or inLondon ? 1.0 : inAsia ? 0.7 : 0.4
sessionLabel = inNY ? "NY" : inLondon ? "London" : inAsia ? "Asia" : "Off"

// -----------------------------------------------------------------------------
// Confidence Scores
// -----------------------------------------------------------------------------
htfBullScore = htfTrendUp ? htfStrengthNorm : 0.0
htfBearScore = htfTrendDown ? htfStrengthNorm : 0.0

bullTrendScore = ltfTrendUp ? 1.0 : pullbackUp ? 0.6 : 0.2
bearTrendScore = ltfTrendDown ? 1.0 : pullbackDown ? 0.6 : 0.2

regimeScore = chopRisk ? 0.2 : trendRegime ? 1.0 : 0.6

ofBullScore = f_clamp((orderflow + 1) * 0.5, 0, 1)
ofBearScore = f_clamp((-orderflow + 1) * 0.5, 0, 1)

penalty = (chopRisk ? 0.25 : 0) + (lowVol ? 0.25 : 0) + (exhaustionRisk ? 0.2 : 0) + (directionConflict ? 0.2 : 0)

bullBase = (htfBullScore + bullTrendScore + regimeScore + sessionScore + ofBullScore) / 5
bearBase = (htfBearScore + bearTrendScore + regimeScore + sessionScore + ofBearScore) / 5

bullScore = int(f_clamp(bullBase - penalty, 0, 1) * 100)
bearScore = int(f_clamp(bearBase - penalty, 0, 1) * 100)

dirScore = bullScore - bearScore

standDown = lowVol or exhaustionRisk

biasState = standDown ? "Stand Down" : dirScore >= 20 and bullScore >= strongBiasThresh ? "Strong Call Bias" : dirScore >= 10 and bullScore >= weakBiasThresh ? "Weak Call Bias" : dirScore <= -20 and bearScore >= strongBiasThresh ? "Strong Put Bias" : dirScore <= -10 and bearScore >= weakBiasThresh ? "Weak Put Bias" : "Neutral / Chop"

marketState = exhaustionRisk ? "Exhaustion / Overextended" : chopRisk ? "Compression / Chop" : ltfTrendUp and pullbackUp ? "Trend Pullback Up" : ltfTrendUp ? "Trend Expansion Up" : ltfTrendDown and pullbackDown ? "Trend Pullback Down" : ltfTrendDown ? "Trend Expansion Down" : "Reversal Risk Elevated"

volState = lowVol ? "LOW" : highVol ? "HIGH" : "NORMAL"

consensus = standDown ? "STAND DOWN" : dirScore >= 12 and bullScore >= weakBiasThresh ? "CALL OK" : dirScore <= -12 and bearScore >= weakBiasThresh ? "PUT OK" : "WAIT"

riskText = (chopRisk ? "CHOP RISK | " : "") + (lowVol ? "LOW VOL | " : "") + (exhaustionRisk ? "EXHAUSTION | " : "") + (directionConflict ? "DIRECTION CONFLICT | " : "")
riskTextFinal = riskText == "" ? "NONE" : riskText

// -----------------------------------------------------------------------------
// Visuals
// -----------------------------------------------------------------------------
bullColor = color.new(color.lime, 0)
bearColor = color.new(color.red, 0)
neutralColor = color.new(color.gray, 0)

biasColor = biasState == "Strong Call Bias" or biasState == "Weak Call Bias" ? bullColor : biasState == "Strong Put Bias" or biasState == "Weak Put Bias" ? bearColor : neutralColor

bgcolor(showBackground ? color.new(biasColor, 88) : na)

plot(showHtfRibbon ? htfEmaFast : na, "HTF Fast", color=color.new(color.teal, 10), linewidth=2)
plot(showHtfRibbon ? htfEmaSlow : na, "HTF Slow", color=color.new(color.orange, 10), linewidth=2)

stateChange = marketState != marketState[1]
if barstate.isconfirmed and stateChange
    label.new(bar_index, high, marketState, style=label.style_label_down, color=color.new(biasColor, 10), textcolor=color.white, size=size.tiny)

// -----------------------------------------------------------------------------
// Dashboard
// -----------------------------------------------------------------------------
var table dash = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Bias", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, biasState, text_color=color.white, bgcolor=color.new(biasColor, 70))
    table.cell(dash, 0, 1, "Market State", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 1, marketState, text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(dash, 0, 2, "Consensus", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 2, consensus, text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(dash, 0, 3, "Call Score", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 3, str.tostring(bullScore), text_color=color.white, bgcolor=color.new(bullColor, 80))
    table.cell(dash, 0, 4, "Put Score", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 4, str.tostring(bearScore), text_color=color.white, bgcolor=color.new(bearColor, 80))
    table.cell(dash, 0, 5, "Volatility", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 5, volState, text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(dash, 0, 6, "Session", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 6, sessionLabel, text_color=color.white, bgcolor=color.new(color.black, 80))
    table.cell(dash, 0, 7, "Risk Flags", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 7, riskTextFinal, text_color=color.white, bgcolor=color.new(color.black, 85))

// -----------------------------------------------------------------------------
// Strategy Entries (proxy for manual CALL/PUT validation only)
// -----------------------------------------------------------------------------
tfSeconds = timeframe.in_seconds(timeframe.period)
holdBarsRaw = tfSeconds == 0 ? 6 : math.round(holdSeconds / tfSeconds)
holdBars = math.max(1, int(holdBarsRaw))

var int longEntryBar = na
var int shortEntryBar = na
var int lastTradeBar = na

canEnter = strategy.position_size == 0 and (na(lastTradeBar) or bar_index - lastTradeBar > cooldownBarsInput)

enterLong = barstate.isconfirmed and canEnter and bullScore >= entryScoreThresh and not standDown and not directionConflict
enterShort = barstate.isconfirmed and canEnter and bearScore >= entryScoreThresh and not standDown and not directionConflict

if enterLong
    strategy.entry("CALL", strategy.long, comment="CALL Validation")
    longEntryBar := bar_index
    lastTradeBar := bar_index

if enterShort
    strategy.entry("PUT", strategy.short, comment="PUT Validation")
    shortEntryBar := bar_index
    lastTradeBar := bar_index

if strategy.position_size > 0 and not na(longEntryBar)
    if bar_index - longEntryBar >= holdBars
        strategy.close("CALL", comment="Time Exit")

if strategy.position_size < 0 and not na(shortEntryBar)
    if bar_index - shortEntryBar >= holdBars
        strategy.close("PUT", comment="Time Exit")

if strategy.position_size == 0
    longEntryBar := na
    shortEntryBar := na
